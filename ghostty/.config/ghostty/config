title = "Ghostty"
theme = Gruvbox Dark

initial-command = /usr/bin/tmux new -ADs dev

font-family = Hack Nerd Font Mono
font-feature = -calt
font-feature = -liga
font-feature = -dlig

window-decoration = true
window-padding-color = background
window-padding-x = 2
window-padding-y = 2

confirm-close-surface = false

# Let applications synchronize with the macOS clipboard through OSC 52.
# Clipboard reads are required for Neovim's `p` over SSH and tmux.
clipboard-read = allow
clipboard-write = allow
