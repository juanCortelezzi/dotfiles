# load zsh prompts
fpath=($fpath "$ZDOTDIR/.zfunctions")

if [[ "$(tty)" = "/dev/tty1" ]]; then
    alias x='startx ~/.config/X11/xinitrc'
fi

# forked from christian chiarulli machfiles repo on:
# https://github.com/christianchiarulli/machfiles
## autoload vcs and colors
autoload -Uz add-zsh-hook vcs_info
autoload -U colors && colors

# enable only git so zsh does not probe other VCS backends
zstyle ':vcs_info:*' enable git

# branch-only git info is fast; avoid worktree status checks in large repos
zstyle ':vcs_info:*' check-for-changes false
zstyle ':vcs_info:*' check-for-staged-changes false
zstyle ':vcs_info:git:*' formats " %{$fg[blue]%}(%{$fg[yellow]%}%{$fg[magenta]%} %b%{$fg[blue]%})"
zstyle ':vcs_info:git:*' actionformats " %{$fg[blue]%}(%{$fg[yellow]%}%{$fg[magenta]%} %b%{$fg[red]%}|%a%{$fg[blue]%})"

precmd_vcs_info() { vcs_info }
add-zsh-hook precmd precmd_vcs_info
setopt prompt_subst

PROMPT="%B%{$fg[blue]%}[%{$fg[white]%}%n%{$fg[red]%}@%{$fg[white]%}%m%{$fg[blue]%}]%(?:%{$fg_bold[green]%}$ :%{$fg_bold[red]%}$ )%{$fg[cyan]%}%c%{$reset_color%}"
PROMPT+="\$vcs_info_msg_0_%{$reset_color%} "
